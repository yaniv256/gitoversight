[
  {
    "id": "zara-private-owner-allow",
    "agent": "zara",
    "unix_user": "agent-zara",
    "arguments": [
      "request",
      "--request-id", "crossuser-{{run_id}}-zara-owner",
      "--repository", "yaniv256/gitoversight.test-private",
      "--operation", "issue.create",
      "--title", "Broker owner acceptance {{run_id}}",
      "--body", "Private cross-user acceptance {{run_id}} - Zara",
      "--manifest-hash", "{{manifest_hash}}"
    ],
    "expected_exit_codes": [0],
    "expected_state": "verified",
    "expected_decision": "allowed_private_owner"
  },
  {
    "id": "tomas-private-nonowner-deny",
    "agent": "tomas",
    "unix_user": "agent-tomas",
    "arguments": [
      "request",
      "--request-id", "crossuser-{{run_id}}-tomas-nonowner",
      "--repository", "yaniv256/gitoversight.test-private",
      "--operation", "issue.create",
      "--title", "Broker non-owner denial {{run_id}}",
      "--body", "This must not be created {{run_id}} - Tomas",
      "--manifest-hash", "{{manifest_hash}}"
    ],
    "expected_exit_codes": [2],
    "expected_state": "denied",
    "expected_decision": "branch_grant_required"
  },
  {
    "id": "tomas-exact-branch-allow",
    "agent": "tomas",
    "unix_user": "agent-tomas",
    "arguments": [
      "request",
      "--request-id", "crossuser-{{run_id}}-tomas-branch",
      "--repository", "yaniv256/gitoversight.test-private",
      "--operation", "branch.push",
      "--branch", "agent/tomas-gitoversight-acceptance",
      "--payload-json", "{\"sha\":\"{{private_head_sha}}\"}",
      "--manifest-hash", "{{manifest_hash}}"
    ],
    "expected_exit_codes": [0],
    "expected_state": "verified",
    "expected_decision": "allowed_branch_grant"
  },
  {
    "id": "tomas-wrong-branch-deny",
    "agent": "tomas",
    "unix_user": "agent-tomas",
    "arguments": [
      "request",
      "--request-id", "crossuser-{{run_id}}-tomas-wrong-branch",
      "--repository", "yaniv256/gitoversight.test-private",
      "--operation", "branch.push",
      "--branch", "main",
      "--payload-json", "{\"sha\":\"{{private_head_sha}}\"}",
      "--manifest-hash", "{{manifest_hash}}"
    ],
    "expected_exit_codes": [2],
    "expected_state": "denied",
    "expected_decision": "branch_grant_required"
  },
  {
    "id": "zara-unapproved-public-deny",
    "agent": "zara",
    "unix_user": "agent-zara",
    "arguments": [
      "request",
      "--request-id", "crossuser-{{run_id}}-public-deny",
      "--repository", "yaniv256/gitoversight.test-public",
      "--operation", "issue.create",
      "--title", "Unapproved public denial {{run_id}}",
      "--body", "This must never be published <!-- gitoversight-request:crossuser-{{run_id}}-public-deny -->",
      "--manifest-hash", "{{manifest_hash}}"
    ],
    "expected_exit_codes": [2],
    "expected_state": "denied",
    "expected_decision": "approval_required"
  }
]
