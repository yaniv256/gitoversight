{
  "listen": "127.0.0.1:17445",
  "database_path": "/var/lib/gitoversight-api/gitoversight.db",
  "tenant_id": "default",
  "policy_file": "/etc/gitoversight/policy.json",
  "worker_socket": "/run/gitoversight-worker/worker.sock",
  "git_read_socket": "/run/gitoversight-worker/git-read.sock",
  "git_read_base_url": "https://gitoversight.com/git",
  "read_session_ttl": "10m",
  "authority_socket": "/run/gitoversight-authority/authority.sock",
  "worker_uid": 991,
  "authority_socket_gid": 990,
  "notification_socket": "/run/gitoversight-notifications/notifications.sock",
  "notification_uid": 989,
  "notification_socket_gid": 988,
  "checkpoint_socket": "/run/gitoversight-checkpoint/checkpoint.sock",
  "webhook_secret_file": "/run/credentials/gitoversight-api.service/webhook-secret",
  "enrollment_challenge_ttl": "10m",
  "human_session_ttl": "8h",
  "human_recent_auth_ttl": "10m",
  "signature_ttl": "2m",
  "signature_clock_skew": "30s",
  "checkpoint_timeout": "2s",
  "execution_grant_ttl": "1m",
  "worker_id": "ec2-worker-1",
  "search_db_path": "/var/lib/gitoversight-search/search.db",
  "rate_limit_window": "1m",
  "rate_limit_requests": 120,
  "max_body_bytes": 44040192,
  "max_concurrent": 4,
  "minimum_free_bytes": 134217728,
  "human_approvers": {"human-reviewer": "ExampleGitHubLogin"},
  "allowed_notification_adapters": ["hive"]
}
