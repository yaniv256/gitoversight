{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitoversight.com/schemas/enrollment.schema.json",
  "title": "Agent enrollment challenge request",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "agent_id", "credential_id", "public_key"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1},
    "agent_id": {"type": "string", "minLength": 1},
    "credential_id": {"type": "string", "minLength": 1},
    "public_key": {"type": "string", "minLength": 43, "maxLength": 43},
    "supersedes_credential_id": {"type": "string", "minLength": 1}
  }
}
