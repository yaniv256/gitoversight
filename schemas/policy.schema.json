{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gitoversight.com/schemas/policy.v1.json",
  "title": "Git Oversight policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "generation", "repositories"],
  "properties": {
    "schema_version": {"const": 1},
    "generation": {"type": "integer", "minimum": 1},
    "fallback_owner": {"type": "string", "minLength": 1},
    "fallback_permissions": {"$ref": "#/$defs/permission_set"},
    "repositories": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "visibility", "owners", "authorized_writers", "human_approvers", "standing_exceptions"],
        "properties": {
          "name": {"type": "string", "pattern": "^[^*/?\\[]+/[^*/?\\[]+$"},
          "visibility": {"enum": ["private", "public"]},
          "owners": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "authorized_writers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "human_approvers": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "standing_exceptions": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/operation"}},
          "protected_policy": {"type": "boolean"},
          "permissions": {"$ref": "#/$defs/permission_set"}
        }
      }
    },
    "branch_grants": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["repository", "agent", "branch", "active"],
        "properties": {
          "repository": {"type": "string"}, "agent": {"type": "string"},
          "branch": {"type": "string", "minLength": 1}, "active": {"type": "boolean"}
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "repositories": {
            "contains": {
              "type": "object",
              "properties": {"owners": {"maxItems": 0}},
              "required": ["owners"]
            }
          }
        }
      },
      "then": {"required": ["fallback_owner"]}
    }
  ],
  "$defs": {
    "permission_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read"],
      "properties": {"read": {"type": "boolean"}}
    },
    "operation": {"enum": ["repository.read", "branch.push", "pull_request.create", "pull_request.update", "pull_request.review", "pull_request.reply", "pull_request.merge", "repository.create", "repository.settings.update", "installation.repository.add", "policy.promote", "release.publish", "issue.create", "issue.comment"]}
  }
}
